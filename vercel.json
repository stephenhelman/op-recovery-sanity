{
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "app.northstaroverages.com" }],
      "destination": "/app"
    },
    {
      "source": "/((?!app).*)",
      "has": [{ "type": "host", "value": "app.northstaroverages.com" }],
      "destination": "/app/$1"
    }
  ]
}
